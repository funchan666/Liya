    "Your account profile is private." : {

    },
    "Your account, posts, messages, uploaded media and coins will be permanently deleted. This anonymous account cannot be restored. Unsent drafts are not included." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuenta, publicaciones, mensajes, archivos y monedas se eliminarán permanentemente. Esta cuenta anónima no se puede recuperar. Los borradores sin enviar no se incluyen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre compte, vos publications, messages, médias et pièces seront supprimés définitivement. Ce compte anonyme ne peut pas être restauré. Les brouillons non envoyés ne sont pas inclus."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウント、投稿、メッセージ、メディア、コインが完全に削除されます。この匿名アカウントは復元できません。未送信の下書きは含まれません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的账号、动态、消息、上传的媒体和金币将被永久删除。此匿名账号无法恢复。未发送的草稿不在删除范围内。"
          }
        }
      }
