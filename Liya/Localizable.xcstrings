{
  "sourceLanguage" : "en",
  "strings" : {
    "AI privacy": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "AI 隐私"}}, "es": {"stringUnit": {"state": "translated", "value": "Privacidad de IA"}}, "fr": {"stringUnit": {"state": "translated", "value": "Confidentialité IA"}}, "ja": {"stringUnit": {"state": "translated", "value": "AI のプライバシー"}}}},
    "Your AI privacy": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "你的 AI 隐私"}}, "es": {"stringUnit": {"state": "translated", "value": "Tu privacidad de IA"}}, "fr": {"stringUnit": {"state": "translated", "value": "Votre confidentialité IA"}}, "ja": {"stringUnit": {"state": "translated", "value": "AI のプライバシー"}}}},
    "To reply, Liya sends your message and recent AI conversation to Groq through Supabase. Your conversation is saved to your account. You can change this choice here at any time.": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "为了生成回复，Liya 会通过 Supabase 将你的消息和最近的 AI 对话发送给 Groq。对话会保存到你的账号。你可以随时在此更改选择。"}}, "es": {"stringUnit": {"state": "translated", "value": "Para responder, Liya envía tu mensaje y la conversación reciente con la IA a Groq mediante Supabase. La conversación se guarda en tu cuenta. Puedes cambiar esta opción aquí en cualquier momento."}}, "fr": {"stringUnit": {"state": "translated", "value": "Pour répondre, Liya transmet votre message et les échanges récents avec l’IA à Groq via Supabase. Votre conversation est enregistrée dans votre compte. Vous pouvez modifier ce choix ici à tout moment."}}, "ja": {"stringUnit": {"state": "translated", "value": "返信のため、Liya はあなたのメッセージと最近の AI との会話を Supabase 経由で Groq に送信します。会話はアカウントに保存されます。この選択はいつでもここで変更できます。"}}}},
    "Liya AI is an automated companion, not a person or professional support.": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "Liya AI 是自动化陪伴助手，不是真人或专业支持。"}}, "es": {"stringUnit": {"state": "translated", "value": "Liya AI es un asistente automatizado, no una persona ni asistencia profesional."}}, "fr": {"stringUnit": {"state": "translated", "value": "Liya AI est un compagnon automatisé, et non une personne ou une aide professionnelle."}}, "ja": {"stringUnit": {"state": "translated", "value": "Liya AI は自動の対話アシスタントであり、人間や専門的な支援ではありません。"}}}},
    "Read Privacy Policy": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "阅读隐私政策"}}, "es": {"stringUnit": {"state": "translated", "value": "Leer la política de privacidad"}}, "fr": {"stringUnit": {"state": "translated", "value": "Lire la politique de confidentialité"}}, "ja": {"stringUnit": {"state": "translated", "value": "プライバシーポリシーを読む"}}}},
    "Withdraw AI consent": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "撤回 AI 授权"}}, "es": {"stringUnit": {"state": "translated", "value": "Retirar consentimiento para IA"}}, "fr": {"stringUnit": {"state": "translated", "value": "Retirer le consentement à l’IA"}}, "ja": {"stringUnit": {"state": "translated", "value": "AI への同意を撤回"}}}},
    "Updating…": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "正在更新…"}}, "es": {"stringUnit": {"state": "translated", "value": "Actualizando…"}}, "fr": {"stringUnit": {"state": "translated", "value": "Mise à jour…"}}, "ja": {"stringUnit": {"state": "translated", "value": "更新中…"}}}},
    "Agree and continue": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "同意并继续"}}, "es": {"stringUnit": {"state": "translated", "value": "Aceptar y continuar"}}, "fr": {"stringUnit": {"state": "translated", "value": "Accepter et continuer"}}, "ja": {"stringUnit": {"state": "translated", "value": "同意して続ける"}}}},
    "Not now": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "暂不"}}, "es": {"stringUnit": {"state": "translated", "value": "Ahora no"}}, "fr": {"stringUnit": {"state": "translated", "value": "Pas maintenant"}}, "ja": {"stringUnit": {"state": "translated", "value": "今はしない"}}}},
    "Couldn't check your AI privacy choice. Please try again.": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "无法确认你的 AI 隐私选择，请重试。"}}, "es": {"stringUnit": {"state": "translated", "value": "No se pudo comprobar tu elección de privacidad de IA. Inténtalo de nuevo."}}, "fr": {"stringUnit": {"state": "translated", "value": "Impossible de vérifier votre choix de confidentialité IA. Réessayez."}}, "ja": {"stringUnit": {"state": "translated", "value": "AI のプライバシー設定を確認できませんでした。もう一度お試しください。"}}}},
    "Couldn't update your AI privacy choice. Please try again.": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "无法更新你的 AI 隐私选择，请重试。"}}, "es": {"stringUnit": {"state": "translated", "value": "No se pudo actualizar tu elección de privacidad de IA. Inténtalo de nuevo."}}, "fr": {"stringUnit": {"state": "translated", "value": "Impossible de modifier votre choix de confidentialité IA. Réessayez."}}, "ja": {"stringUnit": {"state": "translated", "value": "AI のプライバシー設定を更新できませんでした。もう一度お試しください。"}}}},
    "Please review your AI privacy choice to continue.": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "请先确认 AI 隐私选择。"}}, "es": {"stringUnit": {"state": "translated", "value": "Revisa tu elección de privacidad de IA para continuar."}}, "fr": {"stringUnit": {"state": "translated", "value": "Vérifiez votre choix de confidentialité IA pour continuer."}}, "ja": {"stringUnit": {"state": "translated", "value": "続けるには AI のプライバシー設定を確認してください。"}}}},
    "AI chat is being prepared. Please try again later.": {"localizations": {"zh-Hans": {"stringUnit": {"state": "translated", "value": "AI 聊天正在准备中，请稍后再试。"}}, "es": {"stringUnit": {"state": "translated", "value": "El chat de IA se está preparando. Inténtalo más tarde."}}, "fr": {"stringUnit": {"state": "translated", "value": "Le chat IA est en cours de préparation. Réessayez plus tard."}}, "ja": {"stringUnit": {"state": "translated", "value": "AI チャットを準備しています。後でもう一度お試しください。"}}}},
      "Couldn't get a reply right now. Please try again.": {
        "localizations": {
          "zh-Hans": {
            "stringUnit": {
              "state": "translated",
              "value": "暂时无法获取回复，请重试。"
            }
          },
          "es": {
            "stringUnit": {
              "state": "translated",
              "value": "No se pudo obtener una respuesta. Inténtalo de nuevo."
            }
          },
          "fr": {
            "stringUnit": {
              "state": "translated",
              "value": "Impossible d’obtenir une réponse. Réessayez."
            }
          },
          "ja": {
            "stringUnit": {
              "state": "translated",
              "value": "返信を取得できませんでした。もう一度お試しください。"
            }
          }
        }
      },
      "Your reply is still being prepared. Please try again shortly.": {
        "localizations": {
          "zh-Hans": {
            "stringUnit": {
              "state": "translated",
              "value": "回复正在生成，请稍后重试。"
            }
          },
          "es": {
            "stringUnit": {
              "state": "translated",
              "value": "Tu respuesta se está preparando. Inténtalo de nuevo en un momento."
            }
          },
          "fr": {
            "stringUnit": {
              "state": "translated",
              "value": "Votre réponse est en cours de préparation. Réessayez dans un instant."
            }
          },
          "ja": {
            "stringUnit": {
              "state": "translated",
              "value": "返信を準備しています。少し待ってからもう一度お試しください。"
            }
          }
        }
      },
      "A little busy right now. Please wait and try again.": {
        "localizations": {
          "zh-Hans": {
            "stringUnit": {
              "state": "translated",
              "value": "现在有点忙，请稍等再试。"
