    "Sending this report shares this message and its attachments with Liya for review. Other messages are not included." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al enviar el reporte, Liya recibirá este mensaje y sus archivos adjuntos para revisarlos. Los demás mensajes permanecerán privados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En envoyant ce signalement, vous communiquez à Liya ce message et ses pièces jointes pour examen. Les autres messages restent privés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "報告すると、このメッセージと添付ファイルが確認のためLiyaに共有されます。他のメッセージは共有されません。"
