        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
    </dependencies>
    <scenes>
        <scene sceneID="launch-scene">
            <objects>
                <viewController id="launch-controller" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="launch-view">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" image="launch-icon" translatesAutoresizingMaskIntoConstraints="NO" id="launch-icon-view">
                                <rect key="frame" x="126.5" y="356" width="140" height="140"/>
                                <constraints>
                                    <constraint firstAttribute="width" constant="140" id="launch-icon-width"/>
