    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take photos for your profile, posts, or messages, and see yourself while waiting for a video call."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz fotos para tu perfil, publicaciones o mensajes y mira tu imagen mientras esperas una videollamada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prenez des photos pour votre profil, vos publications ou vos messages et voyez votre image en attendant un appel vidéo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロフィール、投稿、メッセージ用の写真を撮影したり、ビデオ通話の待機中に自分の映像を確認したりできます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于拍摄头像、动态或私信中的照片，也让你在等待视频通话时看到自己的画面。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The microphone shows your sound level while you wait for a voice or video call. The audio stays on your device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El micrófono muestra el nivel de sonido mientras esperas una llamada de voz o vídeo. El audio permanece en tu dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le micro indique le niveau sonore pendant l’attente d’un appel audio ou vidéo. Le son reste sur votre appareil."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声通話やビデオ通話の待機中に、マイクが拾う音の大きさを表示します。音声は端末内でのみ処理されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "等待语音或视频通话时，麦克风会显示你当前的音量。声音仅在你的设备上处理。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}