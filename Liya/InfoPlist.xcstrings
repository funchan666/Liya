    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can take photos for your profile, posts, and messages or check your framing while waiting for a video call."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes hacer fotos para tu perfil, tus publicaciones o tus mensajes y comprobar el encuadre mientras esperas una videollamada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez prendre des photos pour votre profil, vos publications ou vos messages et vérifier votre cadrage en attendant un appel vidéo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロフィールや投稿、メッセージに使う写真を撮ったり、ビデオ通話の待機中に自分の映り方を確認したりできます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以拍头像、为动态或私信拍照，也可以在等待视频通话时预览自己的画面。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sound meter lets you check your microphone while you wait for a voice or video call."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mientras esperas una llamada de voz o vídeo, el indicador de volumen te permite comprobar si el micrófono capta tu voz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En attendant un appel audio ou vidéo, vous pouvez vérifier que le micro capte votre voix grâce à l’indicateur de volume."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声通話やビデオ通話の待機中に、音量メーターでマイクが声を拾っているか確認できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "等待语音或视频通话时，你可以通过音量条确认麦克风能收到你的声音。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}